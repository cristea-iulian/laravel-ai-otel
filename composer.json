{
    "name": "cristea-iulian/laravel-ai-otel",
    "description": "OpenTelemetry tracing for the Laravel AI SDK, following the OpenTelemetry GenAI semantic conventions.",
    "keywords": ["laravel", "ai", "opentelemetry", "otel", "tracing", "observability", "gen_ai", "llm", "agents", "langfuse", "phoenix"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Iulian Cristea",
            "homepage": "https://github.com/cristea-iulian"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "~0.11.0",
        "open-telemetry/api": "^1.10",
        "open-telemetry/context": "^1.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.26",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/sdk": "^1.15",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "open-telemetry/sdk": "Required by the otlp driver when no TracerProvider is registered globally (^1.15).",
        "open-telemetry/exporter-otlp": "Required by the otlp driver to export spans over OTLP/HTTP (^1.4).",
        "open-telemetry/opentelemetry-auto-laravel": "Nests agent spans under HTTP request and queue job spans, and propagates trace context through queues."
    },
    "autoload": {
        "psr-4": {
            "CristeaIulian\\AiOtel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CristeaIulian\\AiOtel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CristeaIulian\\AiOtel\\AiOtelServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test",
        "fix": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
